# Copy to `.env.local` (git-ignored) and fill in the values.
#
# In Lovable Cloud every variable below was injected into the runtime
# automatically. Outside Lovable, the dev server (vite.config.ts) loads
# `.env` and `.env.local`; on Cloudflare set them with `wrangler secret put`.

# --- Supabase (public; the same values are committed in .env) ---
SUPABASE_URL="https://wywcvoczkjkxhwflwccd.supabase.co"
SUPABASE_PROJECT_ID="wywcvoczkjkxhwflwccd"
SUPABASE_PUBLISHABLE_KEY="<anon key from Supabase dashboard > Project Settings > API>"
VITE_SUPABASE_URL="https://wywcvoczkjkxhwflwccd.supabase.co"
VITE_SUPABASE_PROJECT_ID="wywcvoczkjkxhwflwccd"
VITE_SUPABASE_PUBLISHABLE_KEY="<same anon key>"

# --- Server-only secrets (were stored in Lovable Cloud, never in git) ---
# Bypasses row-level security. Needed by staff PIN sign-in, website appointment
# import, admin recycle-bin actions and the backup/restore scripts.
SUPABASE_SERVICE_ROLE_KEY="<service_role key from Supabase dashboard > Project Settings > API>"

# Encrypts the "site unlocked" cookie set by /gate. Any random string of 32+ chars.
SESSION_SECRET="<openssl rand -hex 32>"

# The password staff type on the /gate screen before they can reach /login.
SITE_PASSWORD="<salon access password>"

# Shared secret the public website uses to call POST /api/public/website-appointment
# (sent as `x-booking-secret`, or used to HMAC-sign the body as `x-soi-signature`).
WEBSITE_BOOKING_SECRET="<openssl rand -hex 32>"

# --- Optional: full Postgres backups with pg_dump (Supabase > Database > Connection string) ---
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
